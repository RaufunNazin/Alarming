{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true",
        "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a",
        "ORG_GRADLE_PROJECT_android.enableMinifyInReleaseBuilds": "true",
        "ORG_GRADLE_PROJECT_android.enableProguardInReleaseBuilds": "true",
        "ORG_GRADLE_PROJECT_android.enableShrinkResourcesInReleaseBuilds": "true",
        "ORG_GRADLE_PROJECT_expo.useLegacyPackaging": "true"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true",
        "ORG_GRADLE_PROJECT_android.enableMinifyInReleaseBuilds": "true",
        "ORG_GRADLE_PROJECT_android.enableProguardInReleaseBuilds": "true",
        "ORG_GRADLE_PROJECT_android.enableShrinkResourcesInReleaseBuilds": "true"
      }
    },
    "production-apk": {
      "distribution": "internal",
      "channel": "production",
      "env": {
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true",
        "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a",
        "ORG_GRADLE_PROJECT_android.enableMinifyInReleaseBuilds": "true",
        "ORG_GRADLE_PROJECT_android.enableProguardInReleaseBuilds": "true",
        "ORG_GRADLE_PROJECT_android.enableShrinkResourcesInReleaseBuilds": "true",
        "ORG_GRADLE_PROJECT_expo.useLegacyPackaging": "true"
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
